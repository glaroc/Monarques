# Build-time values for `vite build` (CI included). The local .env is
# gitignored, so without this the %VITE_*% placeholders in index.html
# ship to production unsubstituted.
VITE_PAGE_TITLE=Carte MMX pro - Mission Monarque
VITE_META_DESCRIPTION=Interactive map to explore the sampling grid for the MMX project
VITE_META_KEYWORDS=butterflies, monarchs, migration, citizen science, map, sampling grid, MMX, Mission Monarque
VITE_LOGO=logo_mmx_en.png
